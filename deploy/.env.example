# Скопируйте в deploy/.env на сервере и заполните. Файл deploy/.env не попадает в git.

# Адрес сервиса без https://. Без своего домена: IP сервера через дефисы + .sslip.io
DOMAIN=130-61-12-34.sslip.io

# Пароль базы (придумайте длинный: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Панель инспектора
INSPECTOR_PASSWORD=
SECRET_KEY=
DEMO_MODE=true
SEED_ON_START=true

# Telegram-бот (в облаке работает через webhook автоматически)
BOT_TOKEN=

# Необязательно
ANTHROPIC_API_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
