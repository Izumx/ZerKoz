# ── База данных ────────────────────────────────────────────────
# Локально с trust-аутентификацией пароль не нужен. Формат postgres:// тоже принимается.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/zherkoz
# TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/zherkoz_test

# ── Панель инспектора ──────────────────────────────────────────
# Пароль входа. Пусто — панель открыта (только для локальной разработки!)
INSPECTOR_PASSWORD=
# Ключ подписи сессий; пусто — генерируется при старте (сессии сбрасываются при перезапуске)
SECRET_KEY=
# Кнопка «Демо: сигнал жителя»
DEMO_MODE=true
# Сгенерировать демо-данные при старте, если БД пуста (для облачного деплоя)
SEED_ON_START=false

# ── Telegram-бот ───────────────────────────────────────────────
# Токен от @BotFather. Без него запускается только веб-панель.
BOT_TOKEN=
# Публичный https-адрес сервиса → бот работает через webhook. Пусто — polling (локально).
# Внимание: локальный polling снимает webhook у бота — не запускайте локально с тем же токеном,
# пока работает облачная версия.
PUBLIC_URL=
# Хранить состояние диалогов в Redis (переживает перезапуск). Пусто — в памяти.
REDIS_URL=
SIGNALS_PER_HOUR=5
SIGNALS_PER_DAY=20

# ── Необязательные интеграции ─────────────────────────────────
# ИИ-подсказка типа нарушения по фото (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Реальный NDVI из Sentinel-2: dataspace.copernicus.eu → User settings → OAuth clients
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

HOST=0.0.0.0
PORT=8000
