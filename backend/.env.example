# Строка подключения к PostgreSQL. Для локальной установки с trust-аутентификацией пароль не нужен.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/zherkoz
# Необязательно: отдельная БД для тестов (по умолчанию <имя>_test)
# TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/zherkoz_test

# Токен Telegram-бота от @BotFather. Без него запускается только веб-панель.
BOT_TOKEN=

HOST=0.0.0.0
PORT=8000
